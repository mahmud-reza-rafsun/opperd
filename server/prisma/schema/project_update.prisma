model ProjectUpdate {
    id                  String   @id @default(uuid())
    title               String
    body                String?
    isVisibleToCustomer Boolean  @default(true)
    projectId           String
    project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    createdAt           DateTime @default(now())

    @@index([projectId, createdAt])
    @@map("project_update")
}
